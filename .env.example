# Copy to .env and replace all three passwords before starting Compose.
APP_PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=clinic
DB_PASSWORD=replace-with-a-long-database-password
DB_NAME=medical-clinic
DB_SSL=false
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
ADMIN_SECRET=replace-with-a-long-admin-password
