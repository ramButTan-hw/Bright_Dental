{
  "name": "medical-clinic-project",
  "version": "1.0.0",
  "description": "Team 1 COSC 3380",
  "main": "index.js",
  "scripts": {
    "start": "node database/bootstrap-db.js && node server.js",
    "dev": "node database/bootstrap-db.js && node server.js",
    "bootstrap": "node database/bootstrap-db.js",
    "verify:schema": "node database/verify-db-schema.js",
    "verify:schema:local": "node database/verify-db-schema.js --target=local",
    "build": "npm ci --prefix clinic-medical --no-audit --no-fund && npm run build --prefix clinic-medical",
    "test": "node --test",
    "copy": "node database/init-db.js",
    "verify:schema:azure": "node database/verify-db-schema.js --target=azure",
    "docker:up": "docker compose up --build -d --wait",
    "docker:down": "docker compose down",
    "deploy:azure": "bash scripts/deploy-azure.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.2.4",
    "mysql": "^2.18.1",
    "mysql2": "^3.20.0",
    "nodemailer": "^8.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
