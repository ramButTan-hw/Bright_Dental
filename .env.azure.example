# Copy to .env.azure. This is sourced by Bash; quote values with spaces or symbols.
AZURE_SUBSCRIPTION_ID='your-subscription-id'
AZURE_RESOURCE_GROUP='bright-dental-rg'
AZURE_LOCATION='centralus'
# Globally unique names; registry name uses only lowercase letters and digits.
AZURE_WEBAPP_NAME='your-bright-dental-app'
AZURE_ACR_NAME='yourbrightdentalregistry'
AZURE_MYSQL_SERVER='your-bright-dental-mysql'
AZURE_MYSQL_USER='clinicadmin'
AZURE_MYSQL_PASSWORD='replace-with-a-long-unique-password'
ADMIN_SECRET='replace-with-a-long-unique-admin-password'
# Optional: AZURE_PLAN_SKU=B1, AZURE_MYSQL_SKU=Standard_B1ms, AZURE_DB_NAME=medical-clinic
